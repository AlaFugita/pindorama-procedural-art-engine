{
  "$defs": {
    "JobStatus": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "WAITING_REVIEW",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "Stage": {
      "enum": [
        "SPEC_VALIDATION",
        "BUILD",
        "RIG",
        "ANIMATION",
        "RENDER",
        "POST_PROCESS",
        "VALIDATION",
        "EXPORT",
        "RUNTIME"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "character_id": {
      "title": "Character Id",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "QUEUED"
    },
    "current_stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "input_manifest": {
      "title": "Input Manifest",
      "type": "string"
    },
    "output_dir": {
      "title": "Output Dir",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "id",
    "project_id",
    "character_id",
    "type",
    "input_manifest",
    "output_dir"
  ],
  "title": "GenerationJob",
  "type": "object"
}
